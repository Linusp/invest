INVEST_DATABASE_URL=sqlite:///./invest.db
INVEST_CELERY_BROKER_URL=redis://localhost:6379/0
INVEST_MARKET_PROVIDER=tushare
INVEST_MARKET_PROVIDER_ORDER=free_first
INVEST_TUSHARE_TOKEN=replace-with-your-tushare-token
IWENCAI_API_KEY=replace-with-your-iwencai-api-key
INVEST_EASTMONEY_TOKEN=D43BF722C8E33BDC906FB84D85E326E8
INVEST_INDEX_FALLBACK_PROVIDER=akshare
INVEST_ETF_FALLBACK_PROVIDER=akshare
INVEST_REPORTING_CURRENCY=CNY
INVEST_AUTO_UPDATE_ENABLED=true
INVEST_AUTO_UPDATE_INTERVAL_MINUTES=60
INVEST_AUTO_UPDATE_LOOKBACK_DAYS=10
INVEST_SEARCH_INDEX_UPDATE_HOUR=3
INVEST_EXCHANGE_RATE_UPDATE_HOUR=23
INVEST_CORS_ORIGINS=[]
INVEST_MCP_ALLOWED_HOSTS=["127.0.0.1","127.0.0.1:*","localhost","localhost:*","app","app:*"]
INVEST_MCP_ALLOWED_ORIGINS=[]

# EastMoney sector (板块) capital flow. Disabled by default; enable to collect.
INVEST_SECTOR_FLOW_ENABLED=false
INVEST_SECTOR_FLOW_LOOKBACK_DAYS=30
# Intraday refresh cadence in minutes; 0 = EOD only.
INVEST_SECTOR_FLOW_UPDATE_MINUTES=0
INVEST_SECTOR_FLOW_UPDATE_HOUR=15
INVEST_SECTOR_FLOW_UPDATE_MINUTE=40
# Promote the top-N boards (by market cap) into SECTOR market scopes.
INVEST_SECTOR_FLOW_SYNC_SCOPES_ENABLED=true
INVEST_SECTOR_FLOW_SYNC_SCOPES_TOP=30
INVEST_SECTOR_FLOW_SYNC_SCOPES_PARENT=em_industry

# Docker Compose only. Keep database credentials URL-safe (letters/digits recommended).
INVEST_PORT=8001
INVEST_WORKER_CONCURRENCY=1
# COMPOSE_DATABASE_URL=sqlite:////data/invest.db
POSTGRES_USER=invest
POSTGRES_PASSWORD=invest
POSTGRES_DB=invest
MYSQL_USER=invest
MYSQL_PASSWORD=invest
MYSQL_DATABASE=invest
